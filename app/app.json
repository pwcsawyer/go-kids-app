{
  "expo": {
    "name": "app",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "default",
    "platforms": ["ios"],
    "backgroundColor": "#FFF8EC",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.pwcsawyer.gokids",
      "supportsTablet": true,
      "isTabletOnly": true,
      "requireFullScreen": false,
      "deploymentTarget": "16.4",
      "infoPlist": {
        "UIApplicationSupportsIndirectInputEvents": true,
        "UISupportsTrueScreenSizeOnMac": true,
        "UILaunchToFullScreenByDefaultOnMac": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["./plugins/withDesignedForIpad"]
  }
}
